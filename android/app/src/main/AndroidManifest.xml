<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bildirim göstermek için (Android 13 ve üstü izin sorar) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Bildirimin vakit girdiği dakikada gelmesi için tam zamanlı alarm -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Telefon yeniden açılınca kurulu bildirimleri geri yüklemek için -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- GPS ile konum bulmak için -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Güncelleme denetimi için internet -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- İndirilen güncellemeyi kurmak için -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Sesli ezan: arka planda ses çalan servis, kilit ekranında tam ekran uyarı -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Pil tasarrufunun ezanı geciktirmemesi için izin isteme -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:label="Ezan Vakitlerim"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Zamanı gelen bildirimi gösteren alıcı -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Telefon açılınca / uygulama güncellenince bildirimleri yeniden kuran alıcı -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Sesli ezan: alarm çalınca uyanan alıcı, ezanı okuyan servis, açılışta alarmları yeniden kuran alıcı -->
        <receiver android:exported="false" android:name=".EzanAlici" />
        <service
            android:name=".EzanServisi"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver android:exported="false" android:name=".AcilisAlici">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Sadece bilgisayardan (adb) deneme için; DUMP izni yalnızca adb'de var -->
        <receiver
            android:exported="true"
            android:name=".DenemeAlici"
            android:permission="android.permission.DUMP" />

        <!-- Ana ekran widget'ları -->
        <receiver android:exported="false" android:name=".KucukWidget" android:label="Vakit (küçük)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_kucuk_bilgi" />
        </receiver>
        <receiver android:exported="false" android:name=".OrtaWidget" android:label="Vakitler (orta)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_orta_bilgi" />
        </receiver>

        <!-- Güncelleme dosyasını kurulum ekranına vermek için -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosyalar"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>

        <!-- Bu satırı silme: Flutter eklentileri bununla kaydolur -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
