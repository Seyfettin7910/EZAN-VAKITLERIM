<?xml version="1.0" encoding="utf-8"?>
<!-- Orta widget (4×2): sıradaki vakit + kalan süre, altında günün altı vakti -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zemin_acik"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_baslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#12302E"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Chronometer
            android:id="@+id/w_kalan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A6416"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_s0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_a0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_a1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_a2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_a3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_a4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_a5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_t5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#12302E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
