<?xml version="1.0" encoding="utf-8"?>
<!-- Orta widget (4×2): üstte sıradaki vakit + kalan süre, altında günün altı vakti 3 + 3 iki satır halinde.
     İki satıra bölündüğü için her vakte geniş yer kalır; yazılar kutuyu dolduracak kadar büyür (kolay okunsun diye). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zemin_acik"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_baslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="İkindi 15:50"
            android:textColor="#0B2321"
            android:textSize="24sp"
            android:textStyle="bold" />
        <Chronometer
            android:id="@+id/w_kalan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="#7A560F"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_s0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/w_a0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:text="İmsak"
                android:textColor="#0B2321"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                android:text="06:04"
                android:textColor="#0B2321"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/w_a1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:text="Güneş"
                android:textColor="#0B2321"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                android:text="07:27"
                android:textColor="#0B2321"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/w_a2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:text="Öğle"
                android:textColor="#0B2321"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                android:text="12:57"
                android:textColor="#0B2321"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_s3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_siradaki"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/w_a3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:text="İkindi"
                android:textColor="#0B2321"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                android:text="15:50"
                android:textColor="#0B2321"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/w_a4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:text="Akşam"
                android:textColor="#0B2321"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                android:text="18:17"
                android:textColor="#0B2321"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_s5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">
            <TextView
                android:id="@+id/w_a5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-medium"
                android:text="Yatsı"
                android:textColor="#0B2321"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                android:text="19:36"
                android:textColor="#0B2321"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
