<?xml version="1.0" encoding="utf-8"?>
<!-- Küçük widget (2×2): sıradaki vakit, saati, kalan süre -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zemin_koyu"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_ad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sıradaki"
        android:textColor="#B9D3CF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_saat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textColor="#F2F5F4"
        android:textSize="38sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/w_kalan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E0B054"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/w_konum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B9D3CF"
        android:textSize="11sp" />
</LinearLayout>
